{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cairn hook session-start", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "cairn hook pre-tool-use", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "cairn hook post-tool-use", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "cairn hook stop", "timeout": 900 }
        ]
      }
    ]
  }
}
